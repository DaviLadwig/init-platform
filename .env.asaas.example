#
# Durante desenvolvimento:
# ASAAS_ENV=sandbox
#
# Produção somente depois de homologar todo o fluxo.
#
# A API key:
# - nunca deve ir para frontend;
# - nunca deve ser commitada;
# - nunca deve aparecer em logs;
# - nunca deve ser enviada em conversas/screenshots.
#
ASAAS_ENV=sandbox
ASAAS_API_KEY=
