# ============================================================
# ASAAS WEBHOOK
# ============================================================
#
# Gere localmente:
# php bin/gerar-token-webhook-asaas.php
#
# Copie o valor para esta variável e configure EXATAMENTE
# o mesmo valor como authToken do Webhook no Asaas.
#
# NUNCA use ASAAS_API_KEY como token de webhook.
#
ASAAS_WEBHOOK_TOKEN=
